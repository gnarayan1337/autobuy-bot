{
  "manifest_version": 3,
  "name": "PS5 Pro \u2022 Sony cart",
  "version": "1.3.1",
  "description": "Refresh the armed Sony Pro tab while unavailable and try Add once when its signed-in offer is visible. Cart only.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://direct.playstation.com/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PS5 Pro cart watch"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'none'; object-src 'none';"
  },
  "incognito": "not_allowed",
  "icons": {
    "128": "icon.png"
  }
}
